{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rino",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#comments" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rino",
          "match": "\\b(صفحة|نمط|حالة|جسم|منطق|دع|ثابت|دالة|أرجع|إذا|وإلا|لكل|في|و|أو|ليس|صحيح|خطأ|لا_شيء|إعدادات|تصحيح|عنوان|فقرة|زر|صورة|رابط|مدخل|قائمة|عنصر_قائمة|اطبع|عند_الضغط|عند_التغيير)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rino",
      "begin": "\"",
      "end": "\""
    },
    "numbers": {
      "name": "constant.numeric.rino",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "comments": {
      "name": "comment.line.double-slash.rino",
      "match": "//.*$"
    }
  },
  "scopeName": "source.rino"
}