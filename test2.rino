صفحة("اختبار")

عنوان("القوائم")

دع فواكه = ["تفاح", "موز", "عنب"]

فقرة("الأصلية: " + دمج(فواكه, " , "))
فقرة("مع إضافة: " + دمج(أضف(فواكه, "بطيخ"), " , "))
فقرة("مع حذف: " + دمج(احذف(فواكه, "موز"), " , "))

عنوان("مدى")

فقرة("1 حتى 10: " + دمج(مدى(1, 10), " "))
فقرة("5 حتى 1: " + دمج(مدى(5, 1), " "))