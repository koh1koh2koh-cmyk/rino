عنوان("Rino 2.0", "", "عنوان_رئيسي")

قسم {
  عنوان_فرعي("نموذج التسجيل")
  
  تسمية("الاسم:")
  مدخل("اكتب اسمك", "حقل_الاسم")
  
  تسمية("المدينة:")
  اختيار("قائمة_المدن"){
    خيار("القاهرة")
    خيار("الإسكندرية")
    خيار("أسوان")
  }
  
  تسمية("ملاحظات:")
  مربع_نص("اكتب ملاحظاتك", "حقل_الملاحظات")
  
  زر("إرسال") عند_الضغط {
    اطبع("تم الإرسال")
  }
}

عنوان_فرعي("الدوال الجديدة")

فقرة("اقتطع: " + اقتطع("مرحبا بالعالم", 0, 5))
