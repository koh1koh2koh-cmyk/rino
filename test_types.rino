صفحة("اختبار نظام الأنواع")

// ==========================================
// تعريف الأنواع
// ==========================================
نوع المستخدم = {
    الاسم: نص,
    العمر: عدد,
    البريد: نص؟
}

نوع النقطة = {
    س: عدد,
    ص: عدد
}

// ==========================================
// الحالة
// ==========================================
حالة {
    دع اسم_المستخدم: نص = "أحمد"
    دع عمر_المستخدم: عدد = 25
    دع نشط: منطقي = صحيح
    دع رسالة_الخطأ: نص؟ = لا_شيء
    دع المستخدمين: قائمة<المستخدم> = []
    دع النقاط: قائمة<النقطة> = []
}

// ==========================================
// المشتقات (تُحسب تلقائيًا)
// ==========================================
مشتق {
    دع التحيّة = "مرحبًا " + اسم_المستخدم
    دع هل_بالغ = عمر_المستخدم >= 18
    دع عدد_المستخدمين = طول(المستخدمين)
}

// ==========================================
// الدوال
// ==========================================
منطق {
    دالة جمع(أ: عدد, ب: عدد) -> عدد {
        أرجع أ + ب
    }
    
    دالة ضرب(أ: عدد, ب: عدد) -> عدد {
        أرجع أ * ب
    }
    
    دالة تحيّة(اسم: نص) -> نص {
        أرجع "أهلاً " + اسم
    }
    
    دالة هل_موجب(س: عدد) -> منطقي {
        أرجع س > 0
    }
    
    دالة متوسط(أرقام: قائمة<عدد>) -> عدد {
        أرجع مجموع(أرقام) / طول(أرقام)
    }
    
    دالة مسافة(أ: النقطة, ب: النقطة) -> عدد {
        دع دس = ب.س - أ.س
        دع دص = ب.ص - أ.ص
        أرجع جذر(دس * دس + دص * دص)
    }
}

// ==========================================
// عناصر الصفحة
// ==========================================
جسم {
    عنوان("اختبار نظام الأنواع")
       
    فقرة("التحية: " + التحيّة)
    
    إذا (هل_بالغ) {
        فقرة("الحالة: المستخدم بالغ")
    } وإلا {
        فقرة("الحالة: المستخدم قاصر")
    }
    
    فقرة("عدد المستخدمين: " + سلسلة(عدد_المستخدمين))
    
    فاصل_أفقي()
    
    فقرة("2 + 3 = " + سلسلة(جمع(2, 3)))
    فقرة("4 × 5 = " + سلسلة(ضرب(4, 5)))
    فقرة("متوسط [10, 20, 30] = " + سلسلة(متوسط([10, 20, 30])))
    
    فاصل_أفقي()
    
    دع ن1: النقطة = { س: 0, ص: 0 }
    دع ن2: النقطة = { س: 3, ص: 4 }
    فقرة("المسافة بين (0,0) و (3,4) = " + سلسلة(مسافة(ن1, ن2)))
    
    لكل (نقطة في النقاط) {
        فقرة("نقطة: (" + سلسلة(نقطة.س) + ", " + سلسلة(نقطة.ص) + ")")
    }
}

// ==========================================
// الاختبارات
// ==========================================
اختبر "عمليات حسابية" {
    توقع_يساوي(جمع(2, 3), 5)
    توقع_يساوي(ضرب(4, 5), 20)
    توقع_يساوي(جمع(0, 0), 0)
    توقع_يساوي(جمع(-1, 1), 0)
}

اختبر "النصوص" {
    توقع_يساوي(تحيّة("سارة"), "أهلاً سارة")
    توقع_يساوي(تحيّة("علي"), "أهلاً علي")
}

اختبر "المنطق" {
    توقع(هل_موجب(5))
    توقع(ليس هل_موجب(-3))
    توقع(ليس هل_موجب(0))
}

اختبر "المتوسط" {
    توقع_يساوي(متوسط([10, 20, 30]), 20)
    توقع_يساوي(متوسط([5, 5, 5, 5]), 5)
}

اختبر "المسافة" {
    توقع_يساوي(مسافة({ س: 0, ص: 0 }, { س: 3, ص: 4 }), 5)
    توقع_يساوي(مسافة({ س: 1, ص: 1 }, { س: 1, ص: 1 }), 0)
}