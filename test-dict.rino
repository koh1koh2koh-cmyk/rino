صفحة("اختبار القواميس")

دع شخص = {
  الاسم: "أحمد",
  العمر: 13,
  المدينة: "القاهرة"
}

دع فريق = {
  الاسم: "الأسود",
  الأعضاء: 5,
  الفائز: صحيح
}

عنوان("معلوماتي")

فقرة("الاسم: " + شخص.الاسم)
فقرة("العمر: " + شخص.العمر + " سنة")
فقرة("المدينة: " + شخص.المدينة)

عنوان("الفريق")

فقرة("اسم الفريق: " + فريق.الاسم)
فقرة("عدد الأعضاء: " + فريق.الأعضاء)
فقرة("هل فاز: " + فريق.الفائز)