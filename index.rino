صفحة("موقعي الشخصي")

نمط {
  عنوان {
    لون: "أبيض"
    خلفية: "أزرق"
    حشوة: "40"
    محاذاة: "وسط"
    استدارة: "15"
  }
  فقرة {
    حجم: "18"
    محاذاة: "وسط"
    هامش: "15"
  }
  زر {
    خلفية: "أخضر"
    لون: "أبيض"
    حشوة: "12"
    استدارة: "8"
    هامش: "8"
  }
  مدخل {
    حشوة: "12"
    حجم: "16"
    استدارة: "8"
    هامش: "8"
    عرض: "350"
  }
  رابط {
    لون: "أزرق"
    حجم: "18"
    هامش: "10"
  }
  قائمة {
    محاذاة: "وسط"
  }
  عنصر_قائمة {
    حشوة: "10"
    هامش: "5"
    لون: "أسود"
    حجم: "18"
  }
}

حالة {
  دع إعجابات = 0
  دع زائر = ""
  دع رسالة = ""
}

عنوان("مرحبا بك في موقعي")

فقرة("أنا مبرمج لغة Rino")
فقرة("عمري 13 سنة")
فقرة("بنيت لغتي الخاصة من الصفر بـ Rust")

فقرة("عدد الإعجابات: " + إعجابات)

زر("❤ أعجبني") عند_الضغط {
  إعجابات = إعجابات + 1
}

زر("👎 لم يعجبني") عند_الضغط {
  إعجابات = إعجابات - 1
}

زر("🔄 صفر") عند_الضغط {
  إعجابات = 0
}

فقرة("— عن مهاراتي —")

قائمة("مهاراتي") {
  عنصر_قائمة("Rust — لبناء المترجمات")
  عنصر_قائمة("JavaScript — لبناء التفاعلية")
  عنصر_قائمة("HTML و CSS — لبناء الصفحات")
  عنصر_قائمة("Git — لإدارة الكود")
}

فقرة("— عن مشاريعي —")

قائمة("مشاريعي") {
  عنصر_قائمة("لغة Rino — لغة برمجة عربية")
  عنصر_قائمة("مترجم Rust — 5000 سطر كود")
  عنصر_قائمة("إضافة VS Code — تلوين الكود")
}

فقرة("— تواصل معي —")

فقرة("اكتب اسمك:")
مدخل("اسمك هنا", "حقل_الاسم")

فقرة("اكتب رسالتك:")
مدخل("رسالتك هنا", "حقل_الرسالة")

زر("أرسل") عند_الضغط {
  زائر = اقرأ("حقل_الاسم")
  رسالة = اقرأ("حقل_الرسالة")
  اطبع("رسالة من: " + زائر)
  اطبع("الرسالة: " + رسالة)
}

زر("🕷 زوار") عند_الضغط {
  إعجابات = إعجابات + 10
}

فقرة("© 2026 — موقعي الشخصي — بلغة Rino")