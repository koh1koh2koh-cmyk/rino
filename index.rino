صفحة("مفكرتي")

نمط {
  .عنوان_رئيسي {
    محاذاة: "وسط"
    حجم: "32"
    لون: "أبيض"
    خلفية: "بنفسجي"
    حشوة: "20"
    استدارة: "10"
  }
  .صندوق {
    خلفية: "أبيض"
    حشوة: "20"
    استدارة: "10"
    هامش: "15"
  }
  مدخل {
    حشوة: "12"
    حجم: "18"
    استدارة: "8"
    هامش: "10"
    عرض: "300"
  }
  زر {
    خلفية: "أخضر"
    لون: "أبيض"
    حشوة: "12"
    استدارة: "8"
    هامش: "5"
  }
  فقرة {
    محاذاة: "وسط"
    حجم: "20"
    هامش: "15"
  }
}

حالة {
  دع الملاحظة = اقرأ_محلي("ملاحظتي")
  إذا (الملاحظة == لا_شيء) {
    الملاحظة = "لا توجد ملاحظة بعد"
  }
}

عنوان("مفكرتي", "", "عنوان_رئيسي")

فقرة("ملاحظتك: " + الملاحظة)

مدخل("اكتب ملاحظتك هنا", "حقل_الملاحظة")

زر("احفظ الملاحظة") عند_الضغط {
  احفظ("ملاحظتي", اقرأ("حقل_الملاحظة"))
  الملاحظة = اقرأ("حقل_الملاحظة")
}