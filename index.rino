صفحة("بياناتي")

نمط {
  عنوان {
    لون: "أبيض"
    خلفية: "أزرق"
    حشوة: "20"
    محاذاة: "وسط"
    استدارة: "10"
  }
  فقرة {
    حجم: "20"
    محاذاة: "وسط"
    هامش: "10"
  }
  مدخل {
    حشوة: "10"
    حجم: "18"
    استدارة: "5"
    هامش: "10"
  }
  زر {
    خلفية: "أخضر"
    لون: "أبيض"
    حشوة: "12"
    استدارة: "5"
  }
}

حالة {
  دع اسمي = ""
  دع عمري = 0
}

عنوان("أدخل بياناتك")

فقرة("اسمك: " + اسمي)
مدخل("اكتب اسمك هنا") عند_التغيير {
  اسمي = اقرأ_مدخل()
}

فقرة("عمرك: " + عمري)
مدخل("اكتب عمرك هنا") عند_التغيير {
  عمري = عدد(اقرأ_مدخل())
}

فقرة("اسمك: " + اسمي + " — عمرك: " + عمري)

إذا (عمري > 18) {
  فقرة("أنت بالغ ✓")
} وإلا {
  فقرة("أنت قاصر")
}