صفحة("موقعي")

نمط {
  عنوان {
    لون: "أبيض"
    خلفية: "أزرق"
    حشوة: "20"
    محاذاة: "وسط"
    استدارة: "10"
  }
  فقرة {
    حجم: "18"
    محاذاة: "وسط"
    هامش: "10"
  }
  زر {
    خلفية: "أخضر"
    لون: "أبيض"
    حشوة: "12"
    استدارة: "5"
  }
}

حالة {
  دع إعجابات = 0
}

عنوان("مرحبا بك في موقعي")
فقرة("هذا موقعي الأول بلغة Rino")

فقرة("الإعجابات: " + إعجابات)
زر("أعجبني") عند_الضغط {
  إعجابات = إعجابات + 1
}