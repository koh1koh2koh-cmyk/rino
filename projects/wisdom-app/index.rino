صفحة("حكمة اليوم")

نمط {
  .عنوان_رئيسي {
    محاذاة: "وسط"
    حجم: "32"
    لون: "أبيض"
    خلفية: "بنفسجي"
    حشوة: "20"
    استدارة: "10"
  }
  .حكمة {
    خلفية: "أصفر"
    حشوة: "30"
    استدارة: "15"
    محاذاة: "وسط"
    حجم: "22"
    هامش: "20"
    حد: "3"
  }
  زر {
    خلفية: "أخضر"
    لون: "أبيض"
    حشوة: "15"
    استدارة: "8"
    هامش: "10"
  }
  فقرة {
    محاذاة: "وسط"
    حجم: "18"
    هامش: "10"
  }
}

حالة {
  دع الحكمة = "جاري التحميل..."
  دع العداد = 0
}

اجلب("https://catfact.ninja/fact", "الحكمة")

عنوان("حكمة اليوم", "", "عنوان_رئيسي")

فقرة("معلومة طريفة:", "", "")

فقرة(الحكمة, "نص_الحكمة", "حكمة")

فقرة("عدد التحديثات: " + العداد)

زر("حكمة جديدة") عند_الضغط {
  العداد = العداد + 1
  اجلب("https://catfact.ninja/fact", "الحكمة")
}