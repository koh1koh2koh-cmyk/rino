صفحة("متجر الفواكه")

نمط {
  .عنوان_رئيسي {
    محاذاة: "وسط"
    حجم: "32"
    لون: "أبيض"
    خلفية: "أخضر"
    حشوة: "20"
    استدارة: "10"
    هامش: "10"
  }
  .سلة_نص {
    محاذاة: "وسط"
    حجم: "20"
    خلفية: "أصفر"
    لون: "أسود"
    حشوة: "15"
    استدارة: "20"
    هامش: "auto"
  }
  .اسم_منتج {
    محاذاة: "وسط"
    لون: "أخضر"
    حجم: "24"
  }
  زر {
    خلفية: "أخضر"
    لون: "أبيض"
    حشوة: "12"
    استدارة: "8"
    هامش: "5"
  }
  فقرة {
    محاذاة: "وسط"
    حجم: "18"
    هامش: "10"
  }
}

حالة {
  دع عدد_السلة = 0
}

عنوان("متجر الفواكه", "", "عنوان_رئيسي")
فقرة("السلة: " + عدد_السلة + " منتج", "", "سلة_نص")

عنوان("منتجاتنا")

قسم {
  عنوان("تفاح أحمر", "", "اسم_منتج")
  فقرة("السعر: 25 جنيه")
  زر("أضف للسلة") عند_الضغط {
    عدد_السلة = عدد_السلة + 1
  }
}

قسم {
  عنوان("موز", "", "اسم_منتج")
  فقرة("السعر: 15 جنيه")
  زر("أضف للسلة") عند_الضغط {
    عدد_السلة = عدد_السلة + 1
  }
}

قسم {
  عنوان("عنب", "", "اسم_منتج")
  فقرة("السعر: 40 جنيه")
  زر("أضف للسلة") عند_الضغط {
    عدد_السلة = عدد_السلة + 1
  }
}

عنوان("تحكم")

زر("تفريغ السلة") عند_الضغط {
  عدد_السلة = 0
}